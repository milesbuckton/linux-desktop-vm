{% extends '_base.j2' %}

{% set marker_name = marker_name | default('ubuntu') %}
{% set display_name = display_name | default('Ubuntu') %}
{% set default_session = 'ubuntu' %}

{% set user_groups = user_groups | default(['sudo', 'audio', 'video', 'render', 'plugdev', 'netdev']) %}
{% set gdm_service = 'gdm3.service' %}

{% set _chrome_install_cmd = 'apt-get install -y google-chrome-stable' %}

{%- set guest_agent_packages = ['spice-vdagent'] %}
{%- set vmtools_service = '' %}
{%- set extra_enable_services = ['spice-vdagentd.service'] %}

{% set plymouth_theme = 'spinner' %}
{% set plymouth_set_theme = 'update-alternatives --set default.plymouth /usr/share/plymouth/themes/spinner/spinner.plymouth' %}
{% set plymouth_grub_args = 'splash quiet video=3456x2234@60' %}
{% set plymouth_grub_regen = 'update-grub' %}
{% set plymouth_initrd_regen = 'update-initramfs -u' %}

{% set _apt_dns_probe_host = 'archive.ubuntu.com' %}
{% set _apt_no_bloat_pkgs = [
  "nvidia-*", "linux-firmware-*", "firmware-iwlwifi", "firmware-atheros",
  "firmware-brcm80211", "firmware-libertas", "firmware-misc-nonfree",
  "firmware-realtek", "firmware-amd-graphics", "hpijs-ppds", "hplip*",
] %}

{% set dconf_wallpaper_find = 'ls /usr/share/backgrounds/*-final-ubuntu.png /usr/share/backgrounds/ubuntu-default-*.png /usr/share/backgrounds/warty-final-ubuntu.png 2>/dev/null | head -1' %}
{% set shell_theme_name = 'Yaru-dark' %}
{# Sound theme: Ubuntu ships yaru-theme-sound and its 10_ubuntu-settings
   gschema.override already defaults org.gnome.desktop.sound theme-name to
   'Yaru'. Writing the system dconf db with a hardcoded 'freedesktop' silently
   overrode that (system-db:local wins for any key the per-user db has not
   set), so every fresh boot got the freedesktop theme. Set the distro-appropriate
   name here and let _dconf_common.j2 interpolate it. #}
{% set sound_theme_name = 'Yaru' %}
{# ding@rastersoft.com (desktop icons) ships in gnome-shell-ubuntu-extensions on
   Ubuntu, already in _apt_core_pkgs -- so install permission and the dconf
   enablement must be set together, and it is. #}
{% set install_desktop_icons = true %}
{# Ubuntu keeps its STOCK dock: ubuntu-dock@ubuntu.com is force-enabled by   #}
{# /usr/share/gnome-shell/modes/ubuntu.json (session mode), independent of   #}
{# our dconf list. Installing dash-to-dock as well would enable two separate  #}
{# dock UUIDs at once, so Ubuntu neither installs nor enables it. Gentoo has  #}
{# no session-mode dock, so it does -- hence the gate is per-distro.         #}
{% set install_dash_to_dock = false %}
{# gdm3 reads /etc/gdm3/custom.conf on Ubuntu (the base template defaults to #}
{# /etc/gdm/custom.conf, which is the Gentoo/systemd-gdm path).              #}
{% set gdm_conf_path = '/etc/gdm3/custom.conf' %}

{# _apt_core_pkgs: NOTE gnome-software -- NOT pulled in by
   ubuntu-desktop-minimal on 26.04 (the seed ships the snap-store snap instead,
   and that snap's launch/store UI is what the snag list flagged as broken).
   Installed as a native deb explicitly -- apt plugins (snap/flatpak) come as
   Recommends -- and asserted in verify_gate_apt so it can never silently
   vanish again. No comments inside the set below: Jinja blocks don't accept
   them. #}
{% set _apt_core_pkgs = [
  "gdm3",
  "gnome-themes-extra",
  "fonts-firacode",
  "xdg-desktop-portal-gnome",
  "plymouth",
  "sound-theme-freedesktop",
  "yaru-theme-sound",
  "gnome-text-editor",
  "yelp",
  "gnome-calendar",
  "gnome-calculator",
  "gnome-characters",
  "gnome-clocks",
  "gnome-sound-recorder",
  "gnome-disk-utility",
  "gnome-shell-extensions",
  "gnome-shell-ubuntu-extensions",
  "gnome-software",
  "gnome-snapshot",
  "gnome-tweaks",
  "gnome-weather",
  "geary",
  "evolution",
  "totem",
  "pipewire",
  "pipewire-pulse",
  "pipewire-alsa",
  "pipewire-jack",
  "wireplumber",
  "libspa-0.2-bluetooth",
  "rtkit",
  "bluez",
  "usbutils",
  "gvfs-backends",
  "flatpak",
  "snapd",
  "mesa-vulkan-drivers",
  "mesa-common-dev",
  "mesa-utils",
  "vulkan-tools",
  "glmark2-es2-wayland",
  "glmark2-wayland",
  "epiphany-browser",
