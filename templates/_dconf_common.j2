  # Set distro wallpaper + dark mode + single workspace + event sounds via system-wide dconf.
  - [ sh, -c, "mkdir -p /etc/dconf/db/local.d /etc/dconf/profile && printf 'user-db:user\\nsystem-db:local\\n' > /etc/dconf/profile/user && WALL=$({{ dconf_wallpaper_find }}); if [ -n \"$WALL\" ]; then printf '[org/gnome/desktop/background]\\npicture-uri=\"file://%s\"\\npicture-uri-dark=\"file://%s\"\\n[org/gnome/desktop/screensaver]\\npicture-uri=\"file://%s\"\\n' \"$WALL\" \"$WALL\" \"$WALL\" > /etc/dconf/db/local.d/00-background; fi && printf '[org/gnome/desktop/interface]\\ncolor-scheme=\"prefer-dark\"\\n' > /etc/dconf/db/local.d/01-dark-mode && printf '[org/gnome/Epiphany/web]\\nenable-webextensions=true\\n' > /etc/dconf/db/local.d/02-epiphany-ext && printf '[org/gnome/mutter]\\ndynamic-workspaces=false\\n[org/gnome/desktop/wm/preferences]\\nnum-workspaces=1\\n' > /etc/dconf/db/local.d/03-workspaces && printf '[org/gnome/desktop/sound]\\nevent-sounds=true\\ntheme-name=\"freedesktop\"\\n' > /etc/dconf/db/local.d/04-sound && printf '[org/gnome/shell]\\nenabled-extensions=[\"burn-my-windows@schneegans.github.com\",\"desktop-cube@schneegans.github.com\",\"dash-to-dock@micxgx.gmail.com\",\"compiz-alike-magic-lamp-effect@hermes83.github.com\",\"compiz-windows-effect@hermes83.github.com\",\"dynamic-panel@velhlkj.com\",\"dynamic-panel-ng@jdneer.com\"]\\n' > /etc/dconf/db/local.d/05-extensions && dconf update 2>&1 | tail -3 || true" ]
