{# ---------------------------------------------------------------------- #}
{# Reusable Jinja2 macros for cloud-init verify gates.                    #}
{# Import in any template: {% from '_macros.j2' import verify_gate_apt %} #}
{# ---------------------------------------------------------------------- #}

{# Verify-gate contract: the orchestrator's _check_success_marker (see
   linux_vm/fleet/ssh.py) treats the build as success ONLY when this
   macro's stdout contains the literal "VERIFY-OK: all required
   components present" string. The MARKER is the real build-success
   contract (AGENTS.md "Verify-block: the build-success contract").
   The companion SIMULATE-OK / SIMULATE-FAIL markers are emitted by the
   simulate-mode blocks per distro and gate the --simulate-only fleet run.

   Because the marker is the ONLY contract, a VERIFY-FAIL from an
   earlier runcmd entry cannot be allowed to coexist with this macro's
   VERIFY-OK: a preceding entry's `exit 1` does not stop later entries,
   so without the guard below a build whose app-set/sound-theme/
   mesa-fork gate failed would still print VERIFY-OK and be reported a
   success. Every distro gate therefore writes /var/log/verify-gate-fail
   on its failure path and this macro refuses to emit a success marker
   when that file exists. The file lives only inside the build (the disk
   is re-converted from the cloud image every build, and runcmd is
   per-instance), so it cannot poison a later boot. #}

{# verify_gate_apt: final build-success gate for APT-based distros.
   Checks that core GNOME components are installed via dpkg.
   Usage: {{ verify_gate_apt() }}
#}
{% macro verify_gate_apt() %}
  - [ sh, -c, "set -e ; fail() { echo \"VERIFY-FAIL: $1\" >&2 ; touch /var/log/verify-gate-fail ; exit 1 ; } ;
      if [ -f /var/log/verify-gate-fail ]; then echo 'VERIFY-FAIL: an earlier verify gate already failed (see /var/log/cloud-init-output.log) -- no success marker may be printed' >&2 ; exit 1 ; fi ;
      dpkg -l gnome-text-editor            2>/dev/null | grep -q '^ii' || fail 'gnome-text-editor missing' ;
      dpkg -l gnome-shell                   2>/dev/null | grep -q '^ii' || fail 'gnome-shell missing' ;
      dpkg -l gdm3                          2>/dev/null | grep -q '^ii' || fail 'gdm3 missing' ;
      dpkg -l gnome-control-center          2>/dev/null | grep -q '^ii' || fail 'gnome-control-center missing' ;
      dpkg -l nautilus                      2>/dev/null | grep -q '^ii' || fail 'nautilus missing' ;
      dpkg -l gnome-software                2>/dev/null | grep -q '^ii' || fail 'gnome-software missing' ;
      test -L /etc/localtime || fail '/etc/localtime is not a symlink (timedated reports Time zone n/a; gnome-calendar crashes)' ;
      echo 'VERIFY-OK: all required components present'" ]
{% endmacro %}
