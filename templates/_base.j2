#cloud-config
{% from '_macros.j2' import verify_gate_apt, verify_gate_rpm %}
# Base cloud-init user-data template. Every distro inherits from this via
# Jinja2 template inheritance and overrides specific blocks.
#
# Block contract:
#   * packages          -- the cloud-init `packages:` list (top-level)
#   * extra_write_files -- additional `write_files` entries beyond /etc/issue
#                          and /usr/local/bin/check-vm (which are baked in here)
#   * bootcmd           -- the `bootcmd:` list (default: empty)
#   * pre_runcmd        -- runcmd entries to run BEFORE the common stuff
#                          (display manager, guest agent, pipewire, AccountsService)
#   * post_runcmd       -- runcmd entries to run AFTER the common stuff
#                          (e.g. extra best-effort app installs)
#
# Variables every concrete template MUST set (or inherit from a family):
#   marker_name      -- prefix of /var/log/<NAME>-vm-setup.log
#   display_name     -- human-readable distro name for final_message
#   gdm_service      -- display-manager service name
#   user_groups      -- list of supplementary groups for the primary user
#
# Variables with sensible defaults:
#   sudo_spec               default 'ALL=(ALL) NOPASSWD:ALL'
#   default_session         default 'gnome'
#   reboot_timeout          default 90
#   vmtools_service         guest-agent service name (empty — guest agent removed)
#   extra_enable_services   default []  (list of additional units to enable)
#
# Note: cloud-init's user-data parses as YAML, so indentation matters.
# Jinja's minus-sign whitespace control on block tags trims trailing newlines.
# Use block tags without the minus sign in YAML block contexts to avoid merging
# the next entry into a preceding literal block.

# ----- Identity -----------------------------------------------------------
hostname: {{ HOSTNAME }}
fqdn: {{ HOSTNAME }}.local
preserve_hostname: false
manage_etc_hosts: true

# ----- Localisation -------------------------------------------------------
# Default timezone Africa/Johannesburg (SAST, UTC+02:00). Default system
# locale en_ZA.UTF-8 (English with South African date/currency/units;
# additional en_GB and en_US locales generated by per-distro bootcmd so
# the user can switch with `localectl set-locale`).
timezone: {{ TIMEZONE }}
locale: en_ZA.UTF-8

# ----- Cloud-init output mirroring (host-visible progress) ---------------
# cloud-init's `output:` directive was previously set to
#   all: "| tee -a /var/log/cloud-init-output.log"
# to redirect output through a pipe to tee. This caused VERIFY-OK loss
# on Gentoo: the 2-hour idle pipe during the gentoo-install.service wait
# loop followed by rapid-fire runcmd entries at the end meant the tee
# pipe's buffer was dropped when cloud-init closed it, silently losing
# the verify block's VERIFY-OK echo. cloud-init already writes runcmd
# subprocess output directly to /var/log/cloud-init-output.log by default
# (no pipe needed), so removing the directive restores correct behavior.
#
# Host-visible progress is handled separately by a backgrounded `tail -f`
# of cloud-init's log files into /dev/ttyS0 (= the host's console.log),
# spawned in bootcmd_block below.

# ----- User ---------------------------------------------------------------
users:
  - name: {{ USERNAME }}
    groups:
{% for group in user_groups %}
      - {{ group }}
{% endfor %}
    shell: /bin/bash
    sudo: "{{ sudo_spec | default('ALL=(ALL) NOPASSWD:ALL') }}"
    lock_passwd: false
{% if SSH_PUBLIC_KEY %}
    # Per-VM ephemeral SSH public key generated by setup_vm.py and
    # written next to the VM as ssh_key.pub. Lets the `monitor --tail`
    # subcommand SSH in for live cloud-init progress without depending
    # on cloud-init's password module having finished. The private key
    # stays on the HOST (target_dir/ssh_key) and is gitignored.
    ssh_authorized_keys:
      - {{ SSH_PUBLIC_KEY }}
{% endif %}

chpasswd:
  expire: false
  users:
    - name: {{ USERNAME }}
      password: {{ PASSWORD }}
      type: text
    - name: root
      password: {{ ROOT_PASSWORD }}
      type: text

ssh_pwauth: true
disable_root: false

{% block cloud_init_wiring %}{% endblock %}

{% block package_management %}
{% if simulate_only %}
# SIMULATE MODE: skip the heavy install. The per-distro {% raw %}{% block simulate_install %}{% endraw %}
# in runcmd will exercise the package resolver against the full intended
# package list and write the result to /var/log/install-simulate.log.
{% else %}
package_update: true
package_upgrade: true
packages:
{% block packages %}{% endblock %}
{% endif %}
{% endblock %}

{% block bootcmd_block %}
{%- if self.bootcmd().strip() %}
bootcmd:
{% block bootcmd %}{% endblock %}
{%- endif %}
{% endblock %}

write_files:
{% include '_write_files_common.j2' %}
  # Explicitly enable Wayland in GDM -- ensures GDM defaults to Wayland
  # session even if the distro's default GDM config disables it.
  - path: /etc/gdm/custom.conf
    permissions: "0644"
    content: |
      [daemon]
      WaylandEnable=true

{% block extra_write_files %}{% endblock %}

runcmd:
{% if simulate_only %}
  # ---- SIMULATE-ONLY runcmd ------------------------------------------
  # Run the package resolver in dry-run mode against the full target
  # list. NO real install happens. Result written to
  # /var/log/install-simulate.log; SIMULATE-OK / SIMULATE-FAIL marker
  # written to /var/log/cloud-init-output.log so the orchestrator can
  # parse the outcome over SSH.
{% block simulate_install %}{% endblock %}
  - [ sh, -c, "echo 'cloud-init first-boot finished at:' $(date -Iseconds) > /var/log/{{ marker_name }}-vm-setup.log" ]
{% else %}
{%- block pre_runcmd %}{% endblock %}
{% include '_runcmd_common.j2' %}
{%- block post_runcmd %}{% endblock %}
  # ---- DISABLE CLOUD-INIT PACKAGE UPDATES ON SUBSEQUENT BOOTS ----------
  # On first boot cloud-init installs packages via the packages: list and
  # runcmd. On every subsequent boot, package_update/package_upgrade would
  # trigger a full system upgrade (dnf upgrade / apt upgrade)
  # which takes 30+ min on distros with large desktop groups (@workstation,
  # task-gnome-desktop). Drop a cloud.cfg.d snippet that disables this
  # AFTER the first boot's installs are done so subsequent boots are fast.
  - [ sh, -c, "printf 'package_update: false\\npackage_upgrade: false\\n' > /etc/cloud/cloud.cfg.d/99-no-upgrade-on-boot.cfg" ]
  # ---- VERIFY BLOCK ----------------------------------------------------
  # The build is SUCCESS only if this block passes. Every distro template
  # overrides {% raw %}{% block verify %}{% endraw %} with the right package-manager-
  # specific checks. On any miss, prints "VERIFY-FAIL: <reason>" to
  # cloud-init-output.log AND exits non-zero so cloud-init flags the
  # whole runcmd module as failed. The orchestrator's
  # `_check_success_marker` looks for "VERIFY-OK:" before treating a
  # cloud-init "error - done" as success-with-warnings.
{% block verify %}{% endblock %}
  # Mark setup complete (the marker check-vm looks for).
  - [ sh, -c, "echo 'cloud-init first-boot finished at:' $(date -Iseconds) > /var/log/{{ marker_name }}-vm-setup.log" ]
{% endif %}

# Do NOT trigger a guest reboot or shutdown from cloud-init -- the
# `power_state` directive is intentionally omitted because the
# orchestrator's phase-3 issues its own clean shutdown over
# SSH once cloud-init reaches `done` / `degraded done`.
#
# Interactive users (running setup_vm.py manually, not via the fleet
# orchestrator) can still get the fresh kernel by running
# `sudo systemctl reboot` themselves after first login.
#
# NOTE: cloud-init's `mode` field only accepts halt/poweroff/reboot
# -- there is no `noop` value. Omitting the entire directive is the
# documented way to disable post-cloud-init power-state changes.

final_message: "{{ display_name }} + GNOME setup complete."
