{% extends '_base.j2' %}

{% set marker_name = marker_name | default('gentoo') %}
{% set display_name = display_name | default('Gentoo') %}
{% set gdm_service = 'gdm.service' %}
{% set skip_gdm_enable = true %}
{% set user_groups = user_groups | default(['wheel', 'audio', 'video', 'input']) %}
{%- set guest_agent_packages = [] %}
{%- set vmtools_service = '' %}
{%- set extra_enable_services = [] %}

{# Google Chrome -- not in the main Gentoo tree. Attempt via the gentoo
   overlay. Best-effort: the overlay may not be available, in which case
   the install fails gracefully and CHROME-MISSING is emitted. #}
{% set _chrome_install_cmd = 'eselect repository enable gentoo 2>/dev/null && emerge --getbinpkgonly --verbose www-client/google-chrome 2>&1 | tail -5' %}

{# Plymouth -- Gentoo's default splash theme. Plymouth bootsplash on
   Gentoo uses dracut for initrd regen and GRUB for cmdline. #}
{% set plymouth_theme = 'charge' %}
{% set plymouth_grub_var = 'GRUB_CMDLINE_LINUX_DEFAULT' %}
{% set plymouth_grub_args = 'splash quiet video=3456x2234@60' %}
{% set plymouth_grub_regen = 'grub2-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true' %}
{% set plymouth_initrd_regen = 'dracut -f 2>/dev/null || true' %}

